# =============================================================================
# SECRETS & CREDENTIALS — NEVER COMMIT THESE
# =============================================================================

# Firebase Google Services config (contains API keys)
# google-services.json
GoogleService-Info.plist

# Firebase Admin SDK service account (contains private key — CRITICAL)
backend/serviceAccountKey.json
serviceAccountKey.json
*serviceAccountKey*.json

# Environment variable files
.env
.env.local
.env.development
.env.production
.env*.local
*.env

# Cloudinary API keys (if ever stored in a file)
cloudinary.config.js

# localtunnel runtime URL (changes every session, no value in git)
lt_url.txt

# EAS / Expo credentials cache
.eas/
credentials.json

# Android keystore files (signing keys)
*.jks
*.keystore

# iOS certificates & provisioning profiles
*.p12
*.mobileprovision
*.cer
*.certSigningRequest

